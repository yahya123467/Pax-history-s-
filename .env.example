# --- AI (OpenRouter, OpenAI-compatible) ---
# Server-side only. Never prefix with VITE_ — it must never reach the browser.
OPENROUTER_API_KEY=
# Any OpenRouter model slug that is good at JSON, e.g. openai/gpt-4o-mini,
# anthropic/claude-sonnet-4.5, google/gemini-2.5-flash, deepseek/deepseek-chat
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to 1 to force the offline mock engine even when a key is present.
AI_MOCK=0
# Request timeout per AI call, ms
AI_TIMEOUT_MS=60000

# --- Server ---
PORT=3001
DATABASE_PATH=./data/pax.sqlite
